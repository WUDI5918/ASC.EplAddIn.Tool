<Window x:Class="AutoSchematicConfigurator.EplAddIn.Tool.TypicalVariablesInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="输入配置参数" Height="400" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource WorkspaceBg}" 
        Foreground="White"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        FontFamily="Segoe UI, Microsoft YaHei">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Variable Form -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="配置参数输入" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="请根据项目要求配置以下配置变量的参数值：" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Variable Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="VariablesFormPanel" Margin="0,0,10,0"/>
        </ScrollViewer>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消 (Cancel)" Width="100" Height="30" Margin="0,0,12,0" IsCancel="True" Background="{StaticResource ButtonBg}" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"/>
            <Button Content="确认生成 (Generate)" Width="130" Height="30" Click="BtnOk_Click" Background="{StaticResource AccentBlue}" Foreground="White" BorderThickness="0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
