<Window x:Class="AutoSchematicConfigurator.EplAddIn.Tool.FormulaEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="表达式构建器 (Expression Builder)" Height="480" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#1F1F1F" 
        Foreground="White"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="JavaScript 公式编辑器" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="White"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Code Editor Area with validation border -->
            <Border x:Name="editorBorder" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="2" Background="{StaticResource ListPaneBg}" Padding="2">
                <Grid>
                    <avalonedit:TextEditor Name="txtEditor"
                                           SyntaxHighlighting="JavaScript"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           ShowLineNumbers="True"
                                           Background="{StaticResource ListPaneBg}"
                                           Foreground="White" />
                    <!-- Validation icon overlay -->
                    <TextBlock x:Name="validationIcon" Text="" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,4,18,0" IsHitTestVisible="False" Opacity="0.7"/>
                </Grid>
            </Border>
            
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            
            <!-- Resources Panel -->
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="2" Background="{StaticResource ListPaneBg}">
                <TabControl Background="{StaticResource ListPaneBg}" BorderThickness="0" Margin="0">
                    <TabItem Header="内置函数">
                        <ListBox Name="lstFunctions" Background="Transparent" BorderThickness="0" MouseDoubleClick="LstFunctions_MouseDoubleClick" Margin="2,5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="当前变量">
                        <ListBox Name="lstVariables" Background="Transparent" BorderThickness="0" MouseDoubleClick="LstVariables_MouseDoubleClick" Margin="2,5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="5,4" Cursor="Hand" ToolTip="双击插入光标处" FontSize="13" Foreground="White" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Validation Error Detail -->
        <Border x:Name="errorBorder" Grid.Row="2" Visibility="Collapsed" Margin="0,6,0,0"
                BorderBrush="#E84040" BorderThickness="1" CornerRadius="2" Background="#2A1515" Padding="8,6">
            <TextBlock x:Name="txtErrorDetail" TextWrapping="Wrap" Foreground="#FF8080" FontSize="12" FontFamily="Consolas"/>
        </Border>
        
        <!-- Bottom Status & Actions -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Content="✓ 验证语法 (Validate)" Width="130" Height="30" Background="{StaticResource AccentBlue}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnValidate_Click" FontWeight="SemiBold"/>
            
            <TextBlock Name="txtStatus" Grid.Column="1" Margin="15,0" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Medium" FontSize="13"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="确认" Width="80" Height="30" Background="{StaticResource AccentBlue}" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
                <Button Content="取消" Width="80" Height="30" Background="{StaticResource ButtonBg}" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
