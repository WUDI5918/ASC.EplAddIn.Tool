<Project Sdk="Microsoft.NET.Sdk">
  <!-- EPLAN SDK install directory. Override on machines/CI where EPLAN lives elsewhere, e.g.:
       dotnet build -p:EplanInstallDir=D:\EPLAN\Bin
       The default resolves to the same location as the old hard-coded relative HintPath
       (5 levels up from this file -> C:\Program Files\EPLAN\Platform\2026.0.3\Bin). -->
  <PropertyGroup>
    <EplanInstallDir Condition="'$(EplanInstallDir)'==''">$(MSBuildThisFileDirectory)..\..\..\..\..\Program Files\EPLAN\Platform\2026.0.3\Bin</EplanInstallDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>AutoSchematicConfigurator.EplAddIn.Tool</AssemblyName>
    <RootNamespace>AutoSchematicConfigurator.EplAddIn.Tool</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Eplan.EC.Contracts">
      <HintPath>$(EplanInstallDir)\Eplan.EC.Contracts.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.AFu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.AFu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Baseu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.Baseu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.DataModelu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.DataModelu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.EServicesu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.EServicesu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Guiu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.Guiu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.HEServicesu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.HEServicesu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.MasterDatau">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.MasterDatau.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.RecorderToolsu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.RecorderToolsu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.RemoteClientu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.RemoteClientu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Remotingu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.Remotingu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Starteru">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.Starteru.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Systemu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.Systemu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.WebServicesu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.WebServicesu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.WebServiceu">
      <HintPath>$(EplanInstallDir)\Eplan.EplApi.WebServiceu.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Jint" Version="4.10.1" />
    <PackageReference Include="NCalc-Edge" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="configurator_data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="breaker_catalog.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
