<Window x:Class="AutoSchematicConfigurator.EplAddIn.Tool.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:AutoSchematicConfigurator.EplAddIn.Tool"
        Title="" Height="720" Width="1180"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1F1F1F" 
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        FontFamily="Segoe UI, Microsoft YaHei">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- eBuild Designer Theme Palette -->
            <SolidColorBrush x:Key="SidebarBg" Color="#151515"/>
            <SolidColorBrush x:Key="ListPaneBg" Color="#222222"/>
            <SolidColorBrush x:Key="WorkspaceBg" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="DetailsBg" Color="#282828"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#0084FF"/>
            <SolidColorBrush x:Key="TextLight" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
            <SolidColorBrush x:Key="BorderDark" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="HeaderBg" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="ButtonBg" Color="#2E2E2E"/>
            <SolidColorBrush x:Key="ToastGreen" Color="#2D7D46"/>

            <!-- Vertical Nav Sidebar Tab Button Style -->
            <Style x:Key="VerticalNavTabBtn" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Highlight bar on the left -->
                                <Border x:Name="ActiveBar" Grid.Column="0" Background="#0084FF" Visibility="Collapsed"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="8.5" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1C1C1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat Action Button Style -->
            <Style x:Key="SidebarIconBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="4" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Row Action Icon Button Style -->
            <Style x:Key="RowActionBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Expander Flat Dark Style -->
            <Style TargetType="Expander">
                <Setter Property="Background" Value="#1F1F1F"/>
                <Setter Property="BorderBrush" Value="#2D2D2D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Converters -->
            <local:MacroElementHeaderConverter x:Key="MacroElementHeaderConverter"/>
            <local:EmpPathToVisibilityConverter x:Key="EmpPathToVisibilityConverter"/>
            <local:MacroPathToMarginConverter x:Key="MacroPathToMarginConverter"/>
            <local:StringListConverter x:Key="StringListConverter"/>
            <local:MacroPathToFileNameConverter x:Key="MacroPathToFileNameConverter"/>

            <!-- ListBox Selection Style for Left Selection Pane -->
            <Style x:Key="SelectionPaneListItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="15,12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#0084FF"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2A2A2A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ListBox Selection Style for Grid Lists -->
            <Style x:Key="GridRowListItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#2D2D2D"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2B3B4C"/>
                        <Setter Property="BorderBrush" Value="#0084FF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#252525"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>  <!-- Main Area -->
        </Grid.RowDefinitions>

        <!-- ==================== TOP BAR ==================== -->
        <Border Grid.Row="0" Background="#0C0C0C" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Width="24" Height="24" Background="#E60012" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="e" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Text="eBUILD" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="|" Foreground="#475569" FontSize="14" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="TxtBreadcrumbs" Text="Designer > eBuild_Macro_GettingStarted > Macro Typicals" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <!-- Notifications -->
                    <Grid Width="32" Height="32" Margin="0,0,10,0">
                        <Button Content="🔔" Style="{StaticResource SidebarIconBtn}" FontSize="14" ToolTip="通知"/>
                        <Border Background="#E60012" CornerRadius="6" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                            <TextBlock Text="15" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Grid Menu -->
                    <Button Content="⠿" Style="{StaticResource SidebarIconBtn}" Width="32" Height="32" FontSize="14" Margin="0,0,10,0"/>
                    <!-- User Profile -->
                    <Border Width="26" Height="26" CornerRadius="13" Background="#0084FF" VerticalAlignment="Center">
                        <TextBlock Text="DR" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/> <!-- Sidebar Navigation -->
                <ColumnDefinition x:Name="ColSelectionArea" Width="240" MinWidth="0" MaxWidth="400"/> <!-- Left Selection Panel -->
                <ColumnDefinition x:Name="ColSelectionSplitter" Width="Auto"/> <!-- Left Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Center Workspace -->
                <ColumnDefinition x:Name="ColDetailsSplitter" Width="Auto"/> <!-- Right Splitter -->
                <ColumnDefinition x:Name="ColDetailsArea" Width="300" MinWidth="0" MaxWidth="450"/> <!-- Right Details Panel -->
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: SIDEBAR NAVIGATION -->
            <Grid Grid.Column="0" Background="#151515">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <Button x:Name="BtnExpandLeft" Content="»" FontSize="18" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Height="40" Width="60" Click="BtnExpandLeft_Click" Visibility="Collapsed" ToolTip="展开左面板" Margin="0,0,0,10"/>
                    <RadioButton Content="Library" Tag="💼" Style="{StaticResource VerticalNavTabBtn}" Checked="Tab_Checked" x:Name="RadTabBuilder" ToolTip="配置项目库"/>
                    <RadioButton Content="Macro" Tag="🧿" Style="{StaticResource VerticalNavTabBtn}" IsChecked="True" Checked="Tab_Checked" x:Name="RadTabMacro" ToolTip="宏规则 (Macro Typicals)"/>
                    <RadioButton Content="Typical" Tag="👥" Style="{StaticResource VerticalNavTabBtn}" Checked="Tab_Checked" x:Name="RadTabGroup" ToolTip="规则组 (Typical Groups)"/>
                    <RadioButton Content="Config" Tag="⚙️" Style="{StaticResource VerticalNavTabBtn}" Checked="Tab_Checked" x:Name="RadTabConfig" ToolTip="配置器 (Configurators)"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <Button Content="☰" FontSize="16" Foreground="#94A3B8" Height="40" Width="60" Style="{StaticResource SidebarIconBtn}" ToolTip="主菜单"/>
                </StackPanel>
            </Grid>

            <!-- COLUMN 1: LEFT SELECTION PANEL -->
            <Grid Grid.Column="1" Background="#222222" SizeChanged="ColSelectionAreaGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar -->
                    <RowDefinition Height="*"/>    <!-- List -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="15,15,10,10">
                    <Grid>
                        <TextBlock x:Name="TxtSidebarHeader" Text="Macro Typicals" FontSize="14" FontWeight="Bold" Foreground="#0084FF" VerticalAlignment="Center"/>
                        <Button Content="«" HorizontalAlignment="Right" FontSize="14" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Click="BtnCollapseLeft_Click" ToolTip="折叠左面板"/>
                    </Grid>
                </Border>

                <!-- Toolbar -->
                <Border Grid.Row="1" Padding="15,0,15,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnAddNewItem" Content="➕" FontSize="11" Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnAddNewItem_Click" ToolTip="添加"/>
                            <Button Content="📂" FontSize="11" Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnAddNewFolder_Click" ToolTip="新建文件夹" Margin="5,0,0,0"/>
                            <Button Content="📑" FontSize="11" Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnCopySidebarItem_Click" ToolTip="复制" Margin="5,0,0,0"/>
                            <Button Content="🗑️" FontSize="11" Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnDeleteSidebarItem_Click" ToolTip="删除" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Button Content="🔍" HorizontalAlignment="Right" FontSize="11" Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnToggleSearch_Click" ToolTip="搜索"/>
                    </Grid>
                </Border>

                <!-- List -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Floating Search Box -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtSearch" Grid.Row="0" Margin="10,8" Height="28" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333" 
                             TextChanged="TxtSearch_TextChanged" ui:ControlHelper.PlaceholderText="输入关键字搜索..." Visibility="Collapsed"/>
                    
                    <Grid Grid.Row="1">
                        <!-- Left Pane Empty State -->
                        <Border x:Name="GridLeftEmptyState" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ⓘ" FontSize="24" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtLeftEmptyText" Text="No Items" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="LstSidebarItems" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SelectionPaneListItem}"
                                 SelectionChanged="LstSidebarItems_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <!-- COLUMN 2: LEFT SPLITTER -->
            <GridSplitter Grid.Column="2" x:Name="LeftSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#151515" Width="3" Focusable="False"/>

            <!-- COLUMN 3: CENTER WORKSPACE -->
            <Grid Grid.Column="3" Background="#1F1F1F">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColMacroNav" Width="0" MinWidth="0"/> <!-- Macro Navigator Pane -->
                    <ColumnDefinition x:Name="ColMacroNavSplitter" Width="Auto"/> <!-- Navigator Splitter -->
                    <ColumnDefinition Width="*"/>   <!-- Main Editor Panel -->
                </Grid.ColumnDefinitions>

                <!-- MACRO NAVIGATOR PANE -->
                <Border Grid.Column="0" x:Name="GridMacroNav" Background="#222" Visibility="Collapsed" BorderBrush="#2D2D2D" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Padding="12" Background="#1A1A1A" BorderThickness="0,0,0,1" BorderBrush="#2D2D2D">
                            <Grid>
                                <TextBlock Text="EPLAN 宏选择器" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource SidebarIconBtn}" Click="BtnCloseMacroNav_Click"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="TxtSearchMacro" Height="28" Margin="0,0,0,8" TextChanged="TxtSearchMacro_TextChanged" ui:ControlHelper.PlaceholderText="搜索宏..."/>
                            <Button x:Name="BtnRefreshMacroNav" Grid.Row="1" Content="🔄 刷新宏列表" Margin="0,0,0,10" Style="{StaticResource SidebarIconBtn}" Background="#333" Height="28" Click="BtnRefreshMacroNav_Click"/>
                            <ProgressBar x:Name="ProgressBarLoad" Grid.Row="1" Height="4" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed"/>
                            <TreeView Grid.Row="2" x:Name="TvMacros" Background="#1A1A1A" BorderThickness="0" MouseDoubleClick="TvMacros_MouseDoubleClick">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,2,0,2">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- NAVIGATOR SPLITTER -->
                <GridSplitter Grid.Column="1" x:Name="SplitterMacroNav" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#151515" Visibility="Collapsed"/>

                <!-- MAIN EDITOR PANEL -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Workspace Title Bar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable content -->
                        <RowDefinition Height="Auto"/> <!-- Footer status & save -->
                    </Grid.RowDefinitions>

                    <!-- Landing Empty Page -->
                    <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="GridLanding" Background="#1F1F1F" Panel.ZIndex="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AutoSchematicConfigurator" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="选择或新建一个规则以开始配置" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Workspace Title Bar -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="20,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtSelectedName" FontSize="16" FontWeight="Bold" Foreground="White" Background="Transparent" BorderThickness="0" Width="400" LostFocus="TxtSelectedName_LostFocus"/>
                                <TextBlock Text="✏️" Foreground="#475569" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <!-- Expand Details Panel Float Button -->
                            <Button x:Name="BtnExpandRight" Content="«" HorizontalAlignment="Right" FontSize="14" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Click="BtnExpandRight_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- ACCORDION 1: MACROS -->
                            <Expander x:Name="ExpElements" IsExpanded="True" HeaderTemplate="{x:Null}">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}">
                                        <TextBlock x:Name="TxtHeaderElements" Text="Macros (0)" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="10,5">
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Structure view" Foreground="White" Margin="0,0,15,0"/>
                                            <TextBox Width="180" Height="24" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333" ui:ControlHelper.PlaceholderText="Search..."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Macros Table Headers -->
                                    <Border Background="#2A2A2A" BorderBrush="#333" BorderThickness="1,1,1,0" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>  <!-- drag index -->
                                                <ColumnDefinition Width="2*"/> <!-- Name -->
                                                <ColumnDefinition Width="3*"/> <!-- Path -->
                                                <ColumnDefinition Width="1.5*"/> <!-- Variant -->
                                                <ColumnDefinition Width="1.5*"/> <!-- Rep type -->
                                                <ColumnDefinition Width="100"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Name" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="2" Text="Path" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="3" Text="Variant" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="4" Text="Representation type" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="5" Text="Actions" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Macros List Box & Empty State -->
                                    <Grid>
                                        <!-- Empty State -->
                                        <Border x:Name="GridElementsEmptyState" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="20" MinHeight="100" Visibility="Collapsed">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="ⓘ" FontSize="20" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="No macros" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" FontSize="12.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ListBox x:Name="ItrElements" Background="Transparent" BorderBrush="#333" BorderThickness="1" MinHeight="100"
                                                 ItemContainerStyle="{StaticResource GridRowListItem}"
                                                 SelectionChanged="ItrElements_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="::" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                                                            <TextBlock Text="0" Foreground="{StaticResource TextMuted}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding MacroPath, Converter={StaticResource MacroPathToFileNameConverter}}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding MacroPath}" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="Variant A" Foreground="White" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="Multi-line" Foreground="White" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="✏️" Style="{StaticResource RowActionBtn}" Click="BtnReplaceElementMacro_Click" ToolTip="编辑路径"/>
                                                            <Button Grid.Column="1" Content="🔍" Style="{StaticResource RowActionBtn}" Click="BtnShowElementPreview_Click" ToolTip="预览" Margin="5,0,0,0"/>
                                                            <Button Grid.Column="2" Content="⋮" Style="{StaticResource RowActionBtn}" Click="BtnElementMenu_Click" ToolTip="菜单" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <Button Content="＋ 添加宏" Margin="0,10,0,0" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="12,0" HorizontalAlignment="Left" Click="BtnAddElement_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- ACCORDION 2: SCRIPT TYPICALS -->
                            <Expander x:Name="ExpScriptTypicals" IsExpanded="False" Visibility="Collapsed" HeaderTemplate="{x:Null}">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}">
                                        <TextBlock x:Name="TxtHeaderScriptTypicals" Text="Script Typicals (0)" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="10,5">
                                    <Grid Height="40">
                                         <TextBlock Text="No Script Typicals" Foreground="{StaticResource TextMuted}" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>
                                    <Button Content="＋ 添加脚本规则" Margin="0,10,0,0" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="12,0" HorizontalAlignment="Left" Click="BtnAddScriptTypical_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- ACCORDION 3: TYPICAL INSTANCES -->
                            <Expander x:Name="ExpInstances" IsExpanded="True" Visibility="Collapsed" HeaderTemplate="{x:Null}">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}">
                                        <TextBlock x:Name="TxtHeaderInstances" Text="Macro Typicals and Typical Groups (0)" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="10,5">
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="180" Height="24" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333" ui:ControlHelper.PlaceholderText="Search..."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Instances Table Headers -->
                                    <Border Background="#2A2A2A" BorderBrush="#333" BorderThickness="1,1,1,0" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="3*"/> <!-- Target Name -->
                                                <ColumnDefinition Width="2*"/> <!-- Type -->
                                                <ColumnDefinition Width="80"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Target typical" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="2" Text="Type" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Instances List Box & Empty State -->
                                    <Grid>
                                        <!-- Empty State -->
                                        <Border x:Name="GridInstancesEmptyState" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="20" MinHeight="100" Visibility="Collapsed">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="ⓘ" FontSize="20" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="No Macro Typicals or Typical Groups" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" FontSize="12.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ListBox x:Name="ItrInstances" Background="Transparent" BorderBrush="#333" BorderThickness="1" MinHeight="100"
                                                 ItemContainerStyle="{StaticResource GridRowListItem}"
                                                 SelectionChanged="ItrInstances_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="::" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                                                            <TextBlock Text="0" Foreground="{StaticResource TextMuted}"/>
                                                        </StackPanel>

                                                        <ComboBox Grid.Column="1" Height="24" VerticalAlignment="Center"
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AllTypicalTargets}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Name"
                                                                  SelectedValue="{Binding TargetName, Mode=TwoWay}"
                                                                  SelectionChanged="CboTargetTypical_SelectionChanged"/>

                                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                                        <Button Grid.Column="3" Content="🗑️" Style="{StaticResource RowActionBtn}" Click="BtnDeleteInstance_Click" HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <Button Content="＋ 添加实例" Margin="0,10,0,0" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="12,0" HorizontalAlignment="Left" Click="BtnAddInstance_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- ACCORDION 4: CONFIGURATION VARIABLES -->
                            <Expander x:Name="ExpVariables" IsExpanded="True" HeaderTemplate="{x:Null}">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}">
                                        <TextBlock x:Name="TxtHeaderVariables" Text="Configuration variables (0)" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="10,5">
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="180" Height="24" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333" ui:ControlHelper.PlaceholderText="Search..."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Variables Table Headers -->
                                    <Border Background="#2A2A2A" BorderBrush="#333" BorderThickness="1,1,1,0" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="3*"/> <!-- Name -->
                                                <ColumnDefinition Width="3*"/> <!-- Data type -->
                                                <ColumnDefinition Width="2*"/> <!-- Mandatory -->
                                                <ColumnDefinition Width="80"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Name" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="2" Text="Data type" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Grid.Column="3" Text="Mandatory" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Variables List Box -->
                                    <Grid>
                                        <!-- Empty State -->
                                        <Border x:Name="GridVariablesEmptyState" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="20" MinHeight="100" Visibility="Collapsed">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="ⓘ" FontSize="20" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="No configuration variables" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" FontSize="12.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ListBox x:Name="ItrVariables" Background="Transparent" BorderBrush="#333" BorderThickness="1" MinHeight="100"
                                                 ItemContainerStyle="{StaticResource GridRowListItem}"
                                                 SelectionChanged="ItrVariables_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="::" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                                                            <TextBlock Text="0" Foreground="{StaticResource TextMuted}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding IsMandatory}" Foreground="White" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="4" Content="🗑️" Style="{StaticResource RowActionBtn}" Click="BtnDeleteVariable_Click" HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <Button Content="＋ 添加变量" Margin="0,10,0,0" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="12,0" HorizontalAlignment="Left" Click="BtnAddVariable_Click"/>
                                </StackPanel>
                            </Expander>


                            <!-- CONFIGURATOR DETAILS SECTION (CONFIGURATOR TAB ONLY) -->
                            <StackPanel x:Name="GridConfiguratorDetails" Visibility="Collapsed">
                                <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <Label Content="描述 / 说明 (Description):" Foreground="White" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtConfigDescription" Background="#222" BorderBrush="#333" Foreground="White" TextWrapping="Wrap" AcceptsReturn="True" Height="60" LostFocus="TxtConfigDescription_LostFocus"/>
                                    </StackPanel>
                                </Border>
                                <Expander x:Name="ExpConfigGroups" IsExpanded="True" HeaderTemplate="{x:Null}">
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWayToSource}">
                                            <TextBlock x:Name="TxtHeaderConfigGroups" Text="Associated Rule Groups (0)" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="10,5">
                                         <!-- Config Groups Table Headers -->
                                         <Border Background="#2A2A2A" BorderBrush="#333" BorderThickness="1,1,1,0" Padding="10,8">
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="40"/>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="80"/>
                                                 </Grid.ColumnDefinitions>
                                                 <TextBlock Grid.Column="1" Text="Name" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"/>
                                                 <TextBlock Grid.Column="2" Text="Actions" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center"/>
                                             </Grid>
                                         </Border>

                                         <!-- Config Groups List Box & Empty State -->
                                         <Grid>
                                             <!-- Empty State -->
                                             <Border x:Name="GridConfigGroupsEmptyState" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="20" MinHeight="80" Visibility="Collapsed">
                                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                     <TextBlock Text="ⓘ" FontSize="20" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                                     <TextBlock Text="No associated rule groups" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" FontSize="12.5" HorizontalAlignment="Center"/>
                                                 </StackPanel>
                                             </Border>

                                             <ListBox x:Name="ItrConfigGroupsList" Background="Transparent" BorderBrush="#333" BorderThickness="1" MinHeight="80"
                                                      ItemContainerStyle="{StaticResource GridRowListItem}">
                                                 <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid>
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="40"/>
                                                                 <ColumnDefinition Width="*"/>
                                                                 <ColumnDefinition Width="80"/>
                                                             </Grid.ColumnDefinitions>

                                                             <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                 <TextBlock Text="::" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                                                                 <TextBlock Text="0" Foreground="{StaticResource TextMuted}"/>
                                                             </StackPanel>

                                                             <TextBlock Grid.Column="1" Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>

                                                             <Button Grid.Column="2" Content="🗑️" Style="{StaticResource RowActionBtn}" Click="BtnDeleteConfigGroup_Click" HorizontalAlignment="Center"/>
                                                         </Grid>
                                                     </DataTemplate>
                                                 </ListBox.ItemTemplate>
                                             </ListBox>
                                         </Grid>
                                         <Button Content="＋ 添加关联规则组" Margin="0,10,0,0" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="12,0" HorizontalAlignment="Left" Click="BtnAddConfigGroup_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- PROJECT BUILDER DYNAMIC FORM SECTION (BUILDER TAB ONLY) -->
                            <Border x:Name="GridProjectBuilderForm" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="20" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="项目配置表单" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="导入配置" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="8,0" Click="BtnImportBuilderConfig_Click"/>
                                            <Button Content="导出配置" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="28" Padding="8,0" Click="BtnExportBuilderConfig_Click" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="PanelBuilderForm"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Status & Save -->
                    <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" Padding="20,10">
                        <Grid>
                            <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="保存 (Save)" Width="100" Height="30" Click="BtnSave_Click" Style="{StaticResource SidebarIconBtn}" Background="#252525" Margin="0,0,10,0"/>
                                <Button x:Name="BtnGenerate" Content="一键生成图纸" Width="130" Height="30" Click="BtnGenerate_Click" Style="{StaticResource SidebarIconBtn}" Background="#0084FF"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- COLUMN 4: RIGHT SPLITTER -->
            <GridSplitter Grid.Column="4" x:Name="RightSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#151515" Width="3" Focusable="False"/>

            <!-- COLUMN 5: RIGHT DETAILS PANEL -->
            <Grid Grid.Column="5" Background="#282828" x:Name="PanelRightDetails" SizeChanged="ColDetailsAreaGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Details -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="15,15,15,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Background="#222">
                    <Grid>
                        <TextBlock Text="Details" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="»" HorizontalAlignment="Right" FontSize="14" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Click="BtnCollapseRight_Click" ToolTip="折叠右面板"/>
                    </Grid>
                </Border>

                <!-- Scrollable Details Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <!-- EMPTY STATE DETAILS -->
                        <TextBlock x:Name="GridDetailsEmpty" Text="没有选中任何元素" Foreground="{StaticResource TextMuted}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,50,0,0"/>

                        <!-- MACRO ELEMENT DETAILS -->
                        <StackPanel x:Name="GridMacroDetails" Visibility="Collapsed">
                            <!-- Expander: Status -->
                            <Expander Header="Status (Always generated)" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <RadioButton Content="Always generated" x:Name="RadStatusAlways" Checked="RadStatusAlways_Checked" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                                    <RadioButton Content="Dependent" x:Name="RadStatusDependent" Checked="RadStatusDependent_Checked" Foreground="White" Margin="0,0,0,8"/>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtIsActiveFormula" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26"
                                                 Text="{Binding IsActiveFormula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 LostFocus="FormulaTextBox_LostFocus" ToolTip="输入启用条件的逻辑公式"/>
                                        <Button Grid.Column="1" Content="✏️" Style="{StaticResource RowActionBtn}" Click="BtnVariablePicker_Click" Margin="4,0,0,0" ToolTip="选择变量"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Expander: Position -->
                            <Expander Header="Position (Apply from macro)" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <RadioButton Content="Apply from macro" x:Name="RadPosMacro" Checked="RadPosMacro_Checked" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                                    <RadioButton Content="Absolute" x:Name="RadPosAbsolute" Checked="RadPosAbsolute_Checked" Foreground="White" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="20,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- X coordinate -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="X coordinate" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4"
                                                 Text="{Binding X, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>

                                        <!-- Y coordinate -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="Y coordinate" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4"
                                                 Text="{Binding Y, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>

                                        <!-- Sequential -->
                                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Sequential" x:Name="ChkPosSequential" Checked="ChkPosSequential_Checked" Unchecked="ChkPosSequential_Checked" Foreground="White" Margin="0,8,0,4"/>

                                        <!-- Direction -->
                                        <Label Grid.Row="3" Grid.Column="0" Content="Direction" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                         <ComboBox Grid.Row="3" Grid.Column="1" Background="#1A1A1A" Foreground="White" BorderBrush="#333" Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,3" SelectedIndex="0">
                                            <ComboBoxItem Content="To the right"/>
                                            <ComboBoxItem Content="To the left"/>
                                            <ComboBoxItem Content="Up"/>
                                            <ComboBoxItem Content="Down"/>
                                        </ComboBox>

                                        <!-- Offset -->
                                        <Label Grid.Row="4" Grid.Column="0" Content="Offset" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4" Text="0"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Expander: Structure -->
                            <Expander Header="Structure" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <CheckBox Content="Apply from macro" x:Name="ChkStructureMacro" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Function designation [-] -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Function designation [-]" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4"
                                                 Text="{Binding StructureMappings[1].Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>

                                        <!-- Location designation [+] -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="Location designation [+]" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4"
                                                 Text="{Binding StructureMappings[2].Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>

                                        <!-- Document type [&] -->
                                        <Label Grid.Row="2" Grid.Column="0" Content="Document type [&amp;]" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4"
                                                 Text="{Binding StructureMappings[3].Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>

                                        <!-- Page name -->
                                        <Label Grid.Row="3" Grid.Column="0" Content="Page name" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26" Margin="0,4"
                                                 Text="{Binding StructureMappings[4].Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="✏️" Style="{StaticResource RowActionBtn}" Margin="4,4,0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Expander: Variables Mapping -->
                            <Expander Header="Variables" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Placeholder Variables" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <Button Content="🔄 自动提取" Style="{StaticResource SidebarIconBtn}" Click="BtnExtractPlaceholders_Click" Background="#333" Padding="6,2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <ItemsControl ItemsSource="{Binding VariableMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Key}" Foreground="White" FontSize="12" Margin="0,0,0,2"/>
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26"
                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                 LostFocus="FormulaTextBox_LostFocus"/>
                                                        <Button Grid.Column="1" Content="✏️" Style="{StaticResource RowActionBtn}" Click="BtnVariablePicker_Click" Margin="4,0,0,0"/>
                                                        <Button Grid.Column="2" Content="📤" Style="{StaticResource RowActionBtn}" Margin="4,0,0,0" ToolTip="共享变量"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <Button Content="＋ 添加占位符变量" Margin="0,8,0,0" Style="{StaticResource SidebarIconBtn}" Background="#252525" Height="26" Click="BtnAddVarMapping_Click"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- CONFIGURATION VARIABLE DETAILS -->
                        <StackPanel x:Name="GridVariableDetails" Visibility="Collapsed">
                            <Expander Header="Properties" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <!-- Mandatory -->
                                    <CheckBox Content="This is a mandatory variable." IsChecked="{Binding IsMandatory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Foreground="White" Margin="0,0,0,12"/>

                                    <!-- Variable Name -->
                                    <Label Content="Variable name" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="28" Margin="0,0,0,12"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                    <!-- Display Name -->
                                    <Label Content="Display name" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="28"
                                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <Button Grid.Column="1" Content="🌐 en_US" Style="{StaticResource SidebarIconBtn}" Height="28" Padding="6,0" Margin="5,0,0,0"/>
                                    </Grid>

                                    <!-- Data Type -->
                                    <Label Content="Data type" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <ComboBox Background="#1A1A1A" Foreground="White" BorderBrush="#333" Height="28" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                                              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Text (string)" Tag="String"/>
                                        <ComboBoxItem Content="Boolean value (true or false)" Tag="Boolean"/>
                                        <ComboBoxItem Content="Numeric value (integer)" Tag="Integer"/>
                                        <ComboBoxItem Content="Numeric value (double)" Tag="Double"/>
                                    </ComboBox>

                                    <!-- Visibility Formula -->
                                    <Label Content="Visibility" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="28"
                                                 Text="{Binding VisibilityFormula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 LostFocus="FormulaTextBox_LostFocus"/>
                                        <Button Grid.Column="1" Content="✏️" Style="{StaticResource RowActionBtn}" Click="BtnVariablePicker_Click" Margin="5,0,0,0"/>
                                    </Grid>

                                    <!-- Selection Values -->
                                    <Label Content="Selection values" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="28" IsReadOnly="True"
                                                 Text="{Binding PredefinedValues, Converter={StaticResource StringListConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="例如: 选项1, 选项2 (双击或点击右侧编辑)"/>
                                        <Button Grid.Column="1" Content="Edit" Style="{StaticResource SidebarIconBtn}" Click="BtnEditSelectionValues_Click" Height="28" Padding="12,0" Margin="5,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- TYPICAL INSTANCE DETAILS -->
                        <StackPanel x:Name="GridInstanceDetails" Visibility="Collapsed">
                            <!-- Expander: Status -->
                            <Expander Header="Status" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <RadioButton Content="Always active" x:Name="RadInstanceActiveAlways" Checked="RadInstanceActiveAlways_Checked" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                                    <RadioButton Content="Dependent" x:Name="RadInstanceActiveDependent" Checked="RadInstanceActiveDependent_Checked" Foreground="White" Margin="0,0,0,8"/>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtInstanceActiveFormula" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26"
                                                 Text="{Binding IsActiveFormula, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 LostFocus="FormulaTextBox_LostFocus" ToolTip="输入实例启用条件的逻辑公式"/>
                                        <Button Grid.Column="1" Content="✏️" Style="{StaticResource RowActionBtn}" Click="BtnVariablePicker_Click" Margin="4,0,0,0" ToolTip="选择变量"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Expander: Variables Mapping -->
                            <Expander Header="Variables" IsExpanded="True">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Variable Mappings" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding VariableMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Key}" Foreground="White" FontSize="12" Margin="0,0,0,2"/>
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="26"
                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                 LostFocus="FormulaTextBox_LostFocus"/>
                                                        <Button Grid.Column="1" Content="✏️" Style="{StaticResource RowActionBtn}" Click="BtnVariablePicker_Click" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== TOAST NOTIFICATION OVERLAY ==================== -->
        <Border x:Name="ToastBorder" Grid.Row="1" Panel.ZIndex="1000"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,20,20" Background="#282828" BorderBrush="#2D7D46" BorderThickness="4,1,1,1"
                CornerRadius="2" Padding="15,10" Visibility="Collapsed" Width="280">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="✓" Foreground="#2D7D46" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="ToastText" Text="2 macros were added." Foreground="White" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Foreground="#888888" VerticalAlignment="Center" Click="BtnCloseToast_Click"/>
            </Grid>
        </Border>

        <!-- ==================== MODAL OVERLAY 1: CREATE ITEM ==================== -->
        <Grid x:Name="ModalCreateItem" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="5000" Visibility="Collapsed">
            <!-- Background Backdrop -->
            <Border Background="#99000000"/>
            
            <!-- Modal Content Card -->
            <Border Background="#282828" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4"
                    Width="400" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Close -->
                        <RowDefinition Height="*"/>    <!-- Input Field -->
                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock x:Name="TxtModalCreateTitle" Text="Create Typical Group" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource SidebarIconBtn}" Click="BtnCloseCreateModal_Click" ToolTip="关闭"/>
                    </Grid>

                    <!-- Input Field -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Name" Foreground="#94A3B8" FontSize="12.5"/>
                            <TextBlock Text=" *" Foreground="#E60012" FontSize="12.5"/>
                        </StackPanel>
                        <TextBox x:Name="TxtModalCreateName" Background="#1A1A1A" BorderBrush="#333" Foreground="White" Height="28"
                                 TextChanged="TxtModalCreateName_TextChanged"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="BtnModalCreateConfirm" Content="Create" Style="{StaticResource SidebarIconBtn}" Background="#0084FF" Foreground="White" Width="75" Height="28" Click="BtnModalCreateConfirm_Click"/>
                        <Button Content="Cancel" Style="{StaticResource SidebarIconBtn}" Background="#333" Foreground="White" Width="75" Height="28" Click="BtnCloseCreateModal_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MODAL OVERLAY 2: ADD ELEMENTS ==================== -->
        <Grid x:Name="ModalAddElements" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="5000" Visibility="Collapsed">
            <!-- Background Backdrop -->
            <Border Background="#99000000"/>
            
            <!-- Modal Content Card -->
            <Border Background="#282828" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4"
                    Width="450" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Close -->
                        <RowDefinition Height="Auto"/> <!-- Subtitle -->
                        <RowDefinition Height="*"/>    <!-- Filter, Search, List -->
                        <RowDefinition Height="Auto"/> <!-- Status & Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <TextBlock x:Name="TxtModalAddTitle" Text="Add elements" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource SidebarIconBtn}" Click="BtnCloseAddModal_Click" ToolTip="关闭"/>
                    </Grid>

                    <!-- Subtitle -->
                    <TextBlock x:Name="TxtModalAddSubtitle" Grid.Row="1" Text="Select elements to be added to the Typical Group." Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,15"/>

                    <!-- Filter, Search, List -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Filter ComboBox -->
                            <RowDefinition Height="Auto"/> <!-- Search Box -->
                            <RowDefinition Height="*"/>    <!-- Checkable ListBox -->
                        </Grid.RowDefinitions>

                        <!-- Filter ComboBox -->
                        <Label Content="Filter Typicals" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboModalAddFilter" Grid.Row="0" SelectedIndex="0" Background="#1A1A1A" Foreground="White" BorderBrush="#333" Height="28" Margin="0,0,0,10" SelectionChanged="CboModalAddFilter_SelectionChanged">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Macro Typicals"/>
                            <ComboBoxItem Content="Typical Groups"/>
                        </ComboBox>

                        <!-- Search Box -->
                        <TextBox x:Name="TxtModalAddSearch" Grid.Row="1" Height="28" Background="#1A1A1A" BorderBrush="#333" Foreground="White"
                                 TextChanged="TxtModalAddSearch_TextChanged" ui:ControlHelper.PlaceholderText="Search" Margin="0,0,0,12"/>

                        <!-- Checkable ListBox -->
                        <ListBox Grid.Row="2" x:Name="LstModalAddElements" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,10"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Checked="ChkModalElement_Checked" Unchecked="ChkModalElement_Unchecked" Margin="5,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12.5"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Status & Buttons -->
                    <Grid Grid.Row="3" Margin="0,5,0,0">
                        <TextBlock x:Name="TxtModalAddSelectedCount" Text="Elements selected: 0" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnModalAddConfirm" Content="Add" Style="{StaticResource SidebarIconBtn}" Background="#0084FF" Foreground="White" Width="75" Height="28" Click="BtnModalAddConfirm_Click"/>
                            <Button Content="Cancel" Style="{StaticResource SidebarIconBtn}" Background="#333" Foreground="White" Width="75" Height="28" Click="BtnCloseAddModal_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- ==================== MODAL OVERLAY 3: CONFIRM DELETE ==================== -->
        <Grid x:Name="ModalConfirmDelete" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="5000" Visibility="Collapsed">
            <!-- Background Backdrop -->
            <Border Background="#99000000"/>
            
            <!-- Modal Content Card -->
            <Border Background="#282828" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4"
                    Width="380" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Close -->
                        <RowDefinition Height="*"/>    <!-- Warning Message -->
                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtModalDeleteTitle" Text="确认删除" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource SidebarIconBtn}" Click="BtnCloseDeleteModal_Click" ToolTip="关闭"/>
                    </Grid>

                    <!-- Message Content -->
                    <TextBlock x:Name="TxtModalDeleteMessage" Grid.Row="1" Text="确定要删除该项吗？" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnModalDeleteConfirm" Content="确定" Style="{StaticResource SidebarIconBtn}" Background="#EF4444" Foreground="White" Width="75" Height="28" Click="BtnModalDeleteConfirm_Click"/>
                        <Button Content="取消" Style="{StaticResource SidebarIconBtn}" Background="#333" Foreground="White" Width="75" Height="28" Click="BtnCloseDeleteModal_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
