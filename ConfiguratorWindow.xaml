<Window x:Class="AutoSchematicConfigurator.EplAddIn.Tool.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:AutoSchematicConfigurator.EplAddIn.Tool"
        Title="" Height="720" Width="1180"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1F1F1F" 
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:ScrollViewerHelper.AutoHideScrollBars="False"
        FontFamily="Segoe UI, Microsoft YaHei">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            
            <!-- Converters -->
            <local:MacroElementHeaderConverter x:Key="MacroElementHeaderConverter"/>
            <local:EmpPathToVisibilityConverter x:Key="EmpPathToVisibilityConverter"/>
            <local:MacroPathToMarginConverter x:Key="MacroPathToMarginConverter"/>
            <local:StringListConverter x:Key="StringListConverter"/>
            <local:MacroPathToFileNameConverter x:Key="MacroPathToFileNameConverter"/>
            <local:RowIndexConverter x:Key="RowIndexConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>  <!-- Main Area -->
        </Grid.RowDefinitions>

        <!-- ==================== TOP BAR ==================== -->
        <Border Grid.Row="0" Background="#0C0C0C" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Width="24" Height="24" Background="#0084FF" CornerRadius="5" VerticalAlignment="Center">
                        <TextBlock Text="A" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <TextBlock Text="ASC" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="|" Foreground="#475569" FontSize="14" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="TxtBreadcrumbs" Text="Designer > ASC_Macro_GettingStarted > Macro Typicals" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <!-- Collapse / Hide Window -->
                    <Button x:Name="BtnCollapse" Content="⊟" Style="{StaticResource SidebarIconBtn}" Width="32" Height="32" FontSize="16" FontWeight="Bold" ToolTip="折叠窗口 (隐藏到后台，通过菜单重新打开)" Click="BtnCollapse_Click" Margin="0,0,6,0"/>
                    <!-- Notifications -->
                    <Grid Width="32" Height="32" Margin="0,0,10,0">
                        <Button Content="🔔" Style="{StaticResource SidebarIconBtn}" FontSize="14" ToolTip="通知"/>
                        <Border Background="#E60012" CornerRadius="6" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                            <TextBlock Text="15" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Grid Menu -->
                    <Button Content="⠿" Style="{StaticResource SidebarIconBtn}" Width="32" Height="32" FontSize="14" Margin="0,0,10,0"/>
                    <!-- User Profile -->
                    <Border Width="26" Height="26" CornerRadius="13" Background="#0084FF" VerticalAlignment="Center">
                        <TextBlock Text="DR" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/> <!-- Sidebar Navigation -->
                <ColumnDefinition x:Name="ColSelectionArea" Width="240" MinWidth="0" MaxWidth="400"/> <!-- Left Selection Panel -->
                <ColumnDefinition x:Name="ColSelectionSplitter" Width="Auto"/> <!-- Left Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Center Workspace -->
                <ColumnDefinition x:Name="ColDetailsSplitter" Width="Auto"/> <!-- Right Splitter -->
                <ColumnDefinition x:Name="ColDetailsArea" Width="300" MinWidth="0" MaxWidth="450"/> <!-- Right Details Panel -->
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: SIDEBAR NAVIGATION -->
            <Grid Grid.Column="0" Background="#151515">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <Button x:Name="BtnExpandLeft" Content="»" FontSize="18" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Height="40" Width="60" Click="BtnExpandLeft_Click" Visibility="Collapsed" ToolTip="展开左面板" Margin="0,0,0,10"/>
                    <RadioButton Content="Builder" Tag="💼" Style="{StaticResource VerticalNavTabBtn}" Checked="Tab_Checked" x:Name="RadTabBuilder" ToolTip="配置项目生成器"/>
                    <RadioButton Content="Macro" Tag="🧿" Style="{StaticResource VerticalNavTabBtn}" IsChecked="True" Checked="Tab_Checked" x:Name="RadTabMacro" ToolTip="宏规则 (Macro Typicals)"/>
                    <RadioButton Content="Typical" Tag="👥" Style="{StaticResource VerticalNavTabBtn}" Checked="Tab_Checked" x:Name="RadTabGroup" ToolTip="规则组 (Typical Groups)"/>
                    <RadioButton Content="Config" Tag="⚙️" Style="{StaticResource VerticalNavTabBtn}" Checked="Tab_Checked" x:Name="RadTabConfig" ToolTip="配置器 (Configurators)"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <Button Content="☰" FontSize="16" Foreground="#94A3B8" Height="40" Width="60" Style="{StaticResource SidebarIconBtn}" ToolTip="主菜单"/>
                </StackPanel>
            </Grid>

            <!-- COLUMN 1: LEFT SELECTION PANEL -->
            <Grid Grid.Column="1" Background="#222222" SizeChanged="ColSelectionAreaGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar -->
                    <RowDefinition Height="*"/>    <!-- List -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="15,15,10,10">
                    <Grid>
                        <TextBlock x:Name="TxtSidebarHeader" Text="Macro Typicals" FontSize="14" FontWeight="Bold" Foreground="#0084FF" VerticalAlignment="Center"/>
                        <Button Content="«" HorizontalAlignment="Right" FontSize="14" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Click="BtnCollapseLeft_Click" ToolTip="折叠左面板"/>
                    </Grid>
                </Border>

                <!-- Toolbar -->
                <Border Grid.Row="1" Padding="15,0,15,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnAddNewItem" Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnAddNewItem_Click" ToolTip="添加">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnAddNewFolder_Click" ToolTip="新建文件夹" Margin="5,0,0,0">
                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V8C22,6.9 21.1,6 20,6H12L10,4Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnCopySidebarItem_Click" ToolTip="复制" Margin="5,0,0,0">
                                <Path Data="M19,21H8C6.9,21 6,20.1 6,19V6H8V19H19V21M21,15H11C9.9,15 9,14.1 9,13V3C9,1.9 9.9,1 11,1H21C22.1,1 23,1.9 23,3V13C23,14.1 22.1,15 21,15M21,3H11V13H21V3Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnDeleteSidebarItem_Click" ToolTip="删除" Margin="5,0,0,0">
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SidebarIconBtn}" Width="24" Height="24" Click="BtnToggleSearch_Click" ToolTip="搜索" Margin="5,0,0,0">
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- List -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Floating Search Box -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtSearch" Grid.Row="0" Margin="10,8" Height="28" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333" 
                             TextChanged="TxtSearch_TextChanged" ui:ControlHelper.PlaceholderText="输入关键字搜索..." Visibility="Collapsed"/>
                    
                    <Grid Grid.Row="1">
                        <!-- Left Pane Empty State -->
                        <Border x:Name="GridLeftEmptyState" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ⓘ" FontSize="24" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtLeftEmptyText" Text="No Items" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="LstSidebarItems" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SelectionPaneListItem}"
                                 SelectionChanged="LstSidebarItems_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <!-- COLUMN 2: LEFT SPLITTER -->
            <GridSplitter Grid.Column="2" x:Name="LeftSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#151515" Width="3" Focusable="False"/>

            <!-- COLUMN 3: CENTER WORKSPACE -->
            <Grid Grid.Column="3" Background="#1F1F1F">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColMacroNav" Width="280" MinWidth="0"/> <!-- Macro Navigator Pane -->
                    <ColumnDefinition x:Name="ColMacroNavSplitter" Width="Auto"/> <!-- Navigator Splitter -->
                    <ColumnDefinition Width="*"/>   <!-- Main Editor Panel -->
                </Grid.ColumnDefinitions>

                <!-- MACRO NAVIGATOR PANE -->
                <Border Grid.Column="0" x:Name="GridMacroNav" Background="#222" Visibility="Visible" BorderBrush="#2D2D2D" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Padding="12" Background="#1A1A1A" BorderThickness="0,0,0,1" BorderBrush="#2D2D2D">
                            <Grid>
                                <TextBlock Text="EPLAN 宏选择器" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource SidebarIconBtn}" Click="BtnCloseMacroNav_Click"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="TxtSearchMacro" Height="28" Margin="0,0,0,8" TextChanged="TxtSearchMacro_TextChanged" ui:ControlHelper.PlaceholderText="搜索宏..."/>
                            <Button x:Name="BtnRefreshMacroNav" Grid.Row="1" Content="🔄 刷新宏列表" Margin="0,0,0,10" Style="{StaticResource SidebarIconBtn}" Background="#333" Height="28" Click="BtnRefreshMacroNav_Click"/>
                            <ProgressBar x:Name="ProgressBarLoad" Grid.Row="1" Height="4" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed"/>
                            <TreeView Grid.Row="2" x:Name="TvMacros" Background="#1A1A1A" BorderThickness="0" TreeViewItem.Expanded="TvMacros_Expanded" MouseDoubleClick="TvMacros_MouseDoubleClick">
                                <TreeView.Resources>
                                    <!-- Standard WPF selection override to prevent white-on-white text issues -->
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0084FF" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2B3B4C" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,2,0,2">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" FontFamily="Segoe UI Emoji" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                            <Button Content="👁" Margin="8,0,0,0" Padding="2,0" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" Click="BtnPreviewVariant_Click" ToolTip="预览宏图形">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Variant">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Page">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- NAVIGATOR SPLITTER -->
                <GridSplitter Grid.Column="1" x:Name="SplitterMacroNav" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#151515" Visibility="Visible"/>

                <!-- MAIN EDITOR PANEL -->
                <Grid Grid.Column="2" MinWidth="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Workspace Title Bar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable content -->
                        <RowDefinition Height="Auto"/> <!-- Footer status & save -->
                    </Grid.RowDefinitions>

                    <!-- Landing Empty Page -->
                    <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="GridLanding" Background="#1F1F1F" Panel.ZIndex="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AutoSchematicConfigurator" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="选择或新建一个规则以开始配置" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Workspace Title Bar -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="20,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtSelectedName" FontSize="16" FontWeight="Bold" Foreground="White" Background="Transparent" BorderThickness="0" Width="400" LostFocus="TxtSelectedName_LostFocus"/>
                                <ui:SymbolIcon Symbol="Edit" Foreground="#475569" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <!-- Expand Details Panel Float Button -->
                            <Button x:Name="BtnExpandRight" Content="«" HorizontalAlignment="Right" FontSize="14" Foreground="#94A3B8" Style="{StaticResource SidebarIconBtn}" Click="BtnExpandRight_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- ACCORDION 1: MACROS -->
                            <Expander x:Name="ExpElements" IsExpanded="True" Header="Macros (0)">
                                <StackPanel Margin="10,5">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Structure view" Foreground="White" Margin="0,0,15,0"/>
                                            <TextBox Width="180" Height="24" Background="#1A1A1A" BorderThickness="1" BorderBrush="#333" ui:ControlHelper.PlaceholderText="Search..."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SidebarIconBtn}" Click="BtnToggleColumns_Click" ToolTip="显示/隐藏列" Width="30" Height="24" Margin="5,0,0,0">
                                            <ui:SymbolIcon Symbol="Filter"/>
                                        </Button>
                                    </Grid>

                                    <!-- Macros DataGrid & Empty State -->
                                    <Grid>
                                        <!-- Empty State -->
                                        <Border x:Name="GridElementsEmptyState" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="20" MinHeight="100" Visibility="Collapsed">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="ⓘ" FontSize="20" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="No macros" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" FontSize="12.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <DataGrid x:Name="ItrElements" AutoGenerateColumns="False" CanUserResizeColumns="True" HeadersVisibility="Column"
                                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                                  BorderBrush="#333" BorderThickness="1" MinHeight="100" SelectionMode="Single"
                                                  GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  RowHeaderWidth="0" IsReadOnly="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  SelectionChanged="ItrElements_SelectionChanged"
                                                  AllowDrop="True" Drop="ItrElements_Drop" DragOver="ItrElements_DragOver" 
                                                  PreviewMouseMove="General_PreviewMouseMove"
                                                  PreviewMouseLeftButtonUp="General_PreviewMouseLeftButtonUp"
                                                  LostMouseCapture="General_LostMouseCapture">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                                                    <Setter Property="SeparatorBrush" Value="Transparent"/>
                                                    <Setter Property="Background" Value="#1A1A1A"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Placeholder">
                                                            <Setter Property="Background" Value="#2D2D2D"/>
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="50" Header="" CanUserResize="False">
                                                     <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                 <Border Background="Transparent" Cursor="SizeAll" Margin="0,0,8,0" Padding="4" Width="20" Height="24"
                                                                         PreviewMouseLeftButtonDown="DragGrip_PreviewMouseLeftButtonDown">
                                                                     <Path Data="M4,6A1,1 0 1,1 2,6A1,1 0 1,1 4,6 M4,12A1,1 0 1,1 2,12A1,1 0 1,1 4,12 M4,18A1,1 0 1,1 2,18A1,1 0 1,1 4,18 M10,6A1,1 0 1,1 8,6A1,1 0 1,1 10,6 M10,12A1,1 0 1,1 8,12A1,1 0 1,1 10,12 M10,18A1,1 0 1,1 8,18A1,1 0 1,1 10,18" 
                                                                           Fill="#94A3B8" Width="10" Height="15" Stretch="Uniform"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                 </Border>
                                                                 <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMuted}">
                                                                     <TextBlock.Text>
                                                                         <MultiBinding Converter="{StaticResource RowIndexConverter}">
                                                                             <Binding/>
                                                                             <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                                         </MultiBinding>
                                                                     </TextBlock.Text>
                                                                 </TextBlock>
                                                             </StackPanel>
                                                         </DataTemplate>
                                                     </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn x:Name="ColName" Width="2*" Header="Name">
                                                     <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="{Binding MacroPath, Converter={StaticResource MacroPathToFileNameConverter}}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="5,0"/>
                                                         </DataTemplate>
                                                     </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn x:Name="ColPath" Width="3*" Header="Path">
                                                     <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="{Binding MacroPath}" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="5,0"/>
                                                         </DataTemplate>
                                                     </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn x:Name="ColVariant" Width="1.5*" Header="Variant">
                                                     <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="Variant A" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                                                         </DataTemplate>
                                                     </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn x:Name="ColRepType" Width="1.5*" Header="Representation type">
                                                     <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="Multi-line" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                                                         </DataTemplate>
                                                     </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Width="100" Header="Actions" CanUserResize="False">
                                                     <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                 <Button Style="{StaticResource RowActionBtn}" Click="BtnReplaceElementMacro_Click" ToolTip="编辑路径">
                                                                     <ui:SymbolIcon Symbol="Edit"/>
                                                                 </Button>
                                                                 <Button Style="{StaticResource RowActionBtn}" Click="BtnShowElementPreview_Click" ToolTip="预览" Margin="5,0,0,0">
                                                                     <ui:SymbolIcon Symbol="Find"/>
                                                                 </Button>
                                                                 <Button Content="⋮" Style="{StaticResource RowActionBtn}" Click="BtnElementMenu_Click" ToolTip="菜单" Margin="5,0,0,0"/>
                                                             </StackPanel>
                                                         </DataTemplate>
                                                     </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>

